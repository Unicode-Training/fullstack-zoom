    <div class="group/main flex">
      <input type="checkbox" id="sidebar-toggle" class="peer/sidebar" hidden />
      <div
        class="group/sidebar relative bg-gray-100 p-5 peer-checked/sidebar:px-0 w-55 peer-checked/sidebar:w-0 min-h-screen overflow-hidden transition-[padding_width]"
      >
        <h3 class="mb-3 pb-3 border-gray-300 border-b text-xl">Navigation</h3>
        <label
          for="sidebar-toggle"
          class="top-2 right-2 fa-angles-left absolute opacity-0 group-hover/sidebar:opacity-100 hover:text-gray-400 transition cursor-pointer fa-solid"
        ></label>
        <div
          class="top-0 right-0 bottom-0 absolute bg-gray-300 opacity-0 group-hover/sidebar:opacity-100 w-1 transition cursor-ew-resize"
        ></div>
      </div>
      <div class="flex-1 p-5">
        <div class="flex items-start gap-3 mb-3">
          <label
            for="sidebar-toggle"
            class="hover:opacity-60 mt-2 cursor-pointer hidden! group-has-[input:checked]/main:block! fa-solid fa-bars"
          ></label>
          <h1 class="flex-1 text-xl">
            Lorem ipsum dolor, sit amet consectetur adipisicing elit Lorem ipsum
            dolor, sit amet consectetur adipisicing elit
          </h1>
        </div>

